# Get this from https://platform.decart.ai after signing up.
# Without it, calls still work but the "AI Effects" (Lucy 2.5) panel stays disabled.
DECART_API_KEY=

# Port the signaling/token server listens on.
PORT=3001

# Origin of the Vite dev server (or your deployed frontend), used for CORS
# and to scope minted Decart client tokens.
CLIENT_ORIGIN=http://localhost:5173

# From Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=
# Secret — server only, bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# From Korapay dashboard (Test Mode while in sandbox). KORAPAY_SECRET_KEY is
# also what verifies incoming webhook signatures — Korapay doesn't use a
# separate webhook-signing secret.
KORAPAY_SECRET_KEY=
KORAPAY_PUBLIC_KEY=
