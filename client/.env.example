# From Supabase dashboard -> Project Settings -> API.
# The anon key is safe to expose in the browser bundle by design — it's
# protected by the database's Row Level Security policies, not by secrecy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed when building for a deployment where the frontend and backend
# are on different origins (see README) — leave empty for local dev.
VITE_API_BASE_URL=
